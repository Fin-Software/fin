module std/hash/sha1

import std/mem
import std/hash/hmac

BLOCK_BYTES, HASH_BYTES int: 64, 20

struct Sha1 { state uint[5], count uint[2], buffer char[BLOCK_BYTES] }

uint #schedule(block uint[16] alias*, i int)
    block[i&15] = (block[(i+13)&15] ^ block[(i+8)&15] ^ block[(i+2)&15] ^ block[i&15])<<%1
    return block[i&15]
;;
uint #schedule0(block uint[16] alias*, i int)
    block[i] = (block[i]<<%24 & 0xFF00FF00) | (block[i]<<%8 & 0x00FF00FF)
    return block[i]
;;

void #r1(v uint, ref uint*, x uint, y uint, z uint*, w uint)
    last uint = *ref; *z += ((last & (x ^ y)) ^ y) + w + 0x5A827999 + v<<%5
    *ref = last<<%30
;;
void #r2(v uint, ref uint*, x uint, y uint, z uint*, w uint)
    last uint = *ref; *z += (last ^ x ^ y) + w + 0x6ED9EBA1 + v<<%5
    *ref = last<<%30
;;
void #r3(v uint, ref uint*, x uint, y uint, z uint*, w uint)
    last uint = *ref; *z += (((last | x) & y) | (last & x)) + w + 0x8F1BBCDC + v<<%5
    *ref = last<<%30
;;
void #r4(v uint, ref uint*, x uint, y uint, z uint*, w uint)
    last uint = *ref; *z += (last ^ x ^ y) + w + 0xCA62C1D6 + v<<%5
    *ref = last<<%30
;;

void sha1Transform(state uint[5]*, buffer char alias[])
    block uint[16] alias* = (uint[16] alias*)&buffer[0]
    a, b, c, d, e uint = state[0], state[1], state[2], state[3], state[4]

    while (i int; i < 15) defer i += 5 ;;
        #r1(a, &b, c, d, &e, #schedule0(block, i  ))
        #r1(e, &a, b, c, &d, #schedule0(block, i+1))
        #r1(d, &e, a, b, &c, #schedule0(block, i+2))
        #r1(c, &d, e, a, &b, #schedule0(block, i+3))
        #r1(b, &c, d, e, &a, #schedule0(block, i+4))
    ;;
    #r1(a, &b, c, d, &e, #schedule0(block, 15))
    #r1(e, &a, b, c, &d, #schedule( block, 16))
    #r1(d, &e, a, b, &c, #schedule( block, 17))
    #r1(c, &d, e, a, &b, #schedule( block, 18))
    #r1(b, &c, d, e, &a, #schedule( block, 19))

    while (i int = 20; i < 40) defer i += 5 ;;
        #r2(a, &b, c, d, &e, #schedule(block, i  ))
        #r2(e, &a, b, c, &d, #schedule(block, i+1))
        #r2(d, &e, a, b, &c, #schedule(block, i+2))
        #r2(c, &d, e, a, &b, #schedule(block, i+3))
        #r2(b, &c, d, e, &a, #schedule(block, i+4))
    ;;
    while (i int = 40; i < 60) defer i += 5 ;;
        #r3(a, &b, c, d, &e, #schedule(block, i  ))
        #r3(e, &a, b, c, &d, #schedule(block, i+1))
        #r3(d, &e, a, b, &c, #schedule(block, i+2))
        #r3(c, &d, e, a, &b, #schedule(block, i+3))
        #r3(b, &c, d, e, &a, #schedule(block, i+4))
    ;;
    while (i int = 60; i < 80) defer i += 5 ;;
        #r4(a, &b, c, d, &e, #schedule(block, i  ))
        #r4(e, &a, b, c, &d, #schedule(block, i+1))
        #r4(d, &e, a, b, &c, #schedule(block, i+2))
        #r4(c, &d, e, a, &b, #schedule(block, i+3))
        #r4(b, &c, d, e, &a, #schedule(block, i+4))
    ;;

    state[0] += a; state[1] += b; state[2] += c; state[3] += d; state[4] += e
;;

void Sha1.init(sha1*)
    sha1.state = { 0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0 }
    sha1.count = { 0, 0 }
;;

void! Sha1.update(sha1*; data char[])
    j, len uint = sha1.count[0], uint(data.len)
    sha1.count[0] += len << 3
    if (sha1.count[0] < j) sha1.count[1] += 1 ;;
    sha1.count[1] += len >> 29
    j = (j >> 3) & 63

    if (j + len > 63)
        i uint = 64 - j
        mem:copy(sha1.buffer[j..j+i], data[..i])
        sha1Transform(&sha1.state, sha1.buffer[..])
        while (i + 63 < len)
            sha1Transform(&sha1.state, data[i..])
            i += 64
        ;;
        j = 0
        mem:copy(sha1.buffer[..len-i], data[i..])
    else
        mem:copy(sha1.buffer[j..j+(len-i)], data[i..])
    ;;
;;

char[HASH_BYTES]! Sha1.final(sha1*)
    finalcount char[8]
    while (k int; k < 8) defer k += 1 ;;
        idx int = k >= 4 ? 0 : 1
        finalcount[k] = char((sha1.count[idx] >> ((3 - (k & 3)) * 8)) & 0xFF)
    ;;

    sha1.update({ 0x80 }[..])!
    while ((sha1.count[0] & 504) != 448) sha1.update({ 0 }[..])! ;;
    sha1.update(finalcount[..])!

    digest char[HASH_BYTES]
    while (k int; k < HASH_BYTES) defer k += 1 ;;
        digest[k] = char((sha1.state[k >> 2] >> ((3 - (k & 3)) * 8)) & 0xFF)
    ;;
    return digest
;;

char[HASH_BYTES]! hash(data char[])
    sha1 Sha1; sha1.init()
    sha1.update(data)!
    return sha1.final()!
;;
