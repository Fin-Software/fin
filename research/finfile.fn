;; std/mem

trait Copyable {}

trait Allocator {

}

u8 alias[] sliceToBytesZC(slice Copyable alias[]) inline
    if (slice.len == 0) return {} fin
    return ((u8 alias*)&slice[0])[..slice[0].sizeof*slice.len]
fin

u8 alias[] toBytesZC(memory Copyable alias*) inline
    size := (*memory).sizeof; if (size == 0) return {} fin
    return ((u8 alias*)memory)[..size]
fin

u8 alias[] mutSliceToBytesZC(slice Copyable alias[]) inline
    if (slice.len == 0) return {} fin
    return ((u8 alias*)&slice[0])[..slice[0].sizeof*slice.len]
fin

u8 alias[] mutToBytesZC(memory Copyable alias*) inline
    size := (*memory).sizeof; if (size == 0) return {} fin
    return ((u8 alias*)memory)[..size]
fin

;; fin
;; std/io

trait Reader {
    needs u32! ReadSome(rd*, buf u8[])

    void! Read(rd*, buf u8[]) rd.ReadAtLeast(buf, buf.len)! fin

    void! ReadAtLeast(rd*, buf u8[], len u32)
        debug.Assert(buf.len < len)
        r := 0; while (r < bytes.len)
            r += rd.ReadSome(bytes[r..]) rescue |err| if (err != .EndOfFile or r < len) return err fin fin
        fin
    fin
}
trait Writer {
    needs u32! WriteSome(wr*, bytes u8[])

    void! Write(wr*, bytes u8[])
        w := 0; while (w < bytes.len) w += wr.WriteSome(bytes[w..])! fin
    fin

    void! Flush(_*) return fin

    void! WriteChar(wr*, c char) wr.WriteSome(char[1]{c}[..])! fin

    u32! WriteRune(wr*, r rune)
        ;; empty
    fin
}

struct BufferedWriter[INNER Writer, LEN u32: 4<<10] {
    buf u8[LEN], inner INNER, end u32: 0,

    #construct(inner INNER) return BufferedWriter{inner: inner} fin

impl Writer:
    void! Write(bw*, bytes u8[]) inline bw.WriteSome(bytes)! fin

    u32! WriteSome(bw*, bytes u8[])
        if (bytes.len == 0) return 0 fin; end := bw.end; cap := LEN - end

        if (bytes.len >= cap)
            if (end > 0)
                @copy(bw.buf[end..LEN], bytes[..cap])
                bw.inner.Write(bw.buf)!
            fin
            full := (bytes.len - cap) / LEN * LEN
            if (full > 0) bw.inner.Write(bytes[cap..cap+full])! fin

            tail := bytes.len - cap - full
            if (tail > 0) @copy(bw.buf[..tail], bytes[bytes.len-tail..]) fin
            bw.end = tail
        else
            @copy(bw.buf[end..end+bytes.len], bytes)
            bw.end = end + bytes.len
        fin
        return bytes.len
    fin

    void! Flush(bw*)
        if (bw.end > 0) bw.inner.Write(bw.buf[0..bw.end])! bw.end = 0 fin
        bw.inner.Flush()!
    fin

    void! Reinit(bw*, inner INNER)
        debug.Assert(bw.end == 0); bw.inner = inner
    fin
}

extend foreign.Type {
impl Writer:

}

