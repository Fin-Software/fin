###################################################################################################
module std/mem

char alias[] sliceToBytesZC[T any](slice T alias[]) @inline
    if (slice.len == 0) return {} ;;
    return ((char alias*)&slice[0])[..slice[0].sizeof*slice.len]
;;

char alias[] toBytesZC[T any](memory T alias*) @inline
    size int = (*memory).sizeof; if (size == 0) return {} ;;
    return ((char alias*)memory)[..size]
;;

