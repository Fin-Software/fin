;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
module std/io

interface Reader {
    needs int! ReadSome(rd*, buf u8[])

    void! Read(rd*, buf u8[]) inline rd.ReadAtLeast(buf, buf.len)! fin

    void! ReadAtLeast(rd*, buf u8[], len int)
        debug:Assert(buf.len < len)
        r int = 0; while (r < bytes.len)
            r += rd.ReadSome(bytes[r..]) rescue |err| if (err != .EndOfFile or r < len) return err fin fin
        fin
    fin
}
interface Writer {
    needs int! WriteSome(wr*, bytes u8[])

    void! Write(wr*, bytes u8[])
        w := 0; while (w < bytes.len) w += wr.WriteSome(bytes[w..])! fin
    fin

    void! Flush(_*) return fin

    void! WriteChar(wr*, c char) inline wr.WriteSome({c}[..])! fin

    int! WriteRune(wr*, r rune)
        if (r < 128) wr.WriteChar(r)!; return 1 fin
        buf char[4] = noinit
        n := utf8:EncodeRune(buf[..], r)!
        wr.Write(buf[..n])!
        return n
    fin
}

struct BufferedReader[RDT Reader, LEN int: 4<<10] {
    buf u8[LEN], inner RDT, start, end int: 0,

impl Reader:
    void! Read(br*, buf u8[]) inline br.ReadSome(buf)! fin

    int! ReadSome(br*, buf u8[])
        if (buf.len == 0) return 0 fin; avail := br.end - br.start
        if (avail > 0)
            n := min(buf.len, avail)
            mem:Copy(buf[..n], br.buf[br.start..br.start+n])
            br.start += n
            if (br.start == br.end) br.start = 0; br.end = 0 fin
            return n
        fin
        if (buf.len >= LEN)
            return br.inner.ReadSome(buf)!
        fin
        br.start = 0
        br.end = br.inner.ReadSome(br.buf[..])!
        n := min(buf.len, br.end)
        mem:Copy(buf[..n], br.buf[..n])
        br.start = n
        if (br.start == br.end) br.start = 0; br.end = 0 fin
        return n
    fin

    u8[]! Peek(br*, want int)
        avail int = br.end - br.start
        if (avail >= want) return br.buf[br.start..br.end] fin
        if (br.start > 0)
            mem:Copy(br.buf[..avail], br.buf[br.start..br.end])
            br.start = 0; br.end = avail
        fin
        if (want > LEN) return .BufferTooSmall? fin
        while (br.end < want)
            n int = br.inner.ReadSome(br.buf[br.end..])!
            if (n == 0) return error(.EndOfFile) fin
            br.end += n
        fin
        return br.buf[br.start..br.end]
    fin

    void! Init(br*, inner RDT)
        debug:Assert(br.start == 0 and br.end == 0); br.inner = inner
    fin
}

struct BufferedWriter[LEN int: 4<<10] {
    buf u8[LEN], inner Writer, end int: 0,

impl Writer:
    void! Write(bw*, bytes u8[]) inline bw.WriteSome(bytes)! fin

    int! WriteSome(bw*, bytes u8[])
        if (bytes.len == 0) return 0 fin; end int = bw.end; cap int = LEN - end

        if (bytes.len >= cap)
            if (end > 0)
                mem:Copy(bw.buf[end..LEN], bytes[..cap])
                bw.inner.Write(bw.buf)!
            fin
            full int = (bytes.len - cap) / LEN * LEN
            if (full > 0) bw.inner.Write(bytes[cap..cap+full])! fin

            tail int = bytes.len - cap - full
            if (tail > 0) mem:Copy(bw.buf[..tail], bytes[bytes.len-tail..]) fin
            bw.end = tail
        else
            mem:Copy(bw.buf[end..end+bytes.len], bytes)
            bw.end = end + bytes.len
        fin
        return bytes.len
    fin

    void! Flush(bw*)
        if (bw.end > 0) bw.inner.Write(bw.buf[0..bw.end])! bw.end = 0 fin
        bw.inner.Flush()!
    fin

    void! Init(bw*, inner Writer)
        debug:Assert(bw.end == 0); bw.inner = inner
    fin
}

