module std/constraints

interface Scalar {}
interface Float: Scalar {}
interface Integer: Scalar {}
interface SignedInt: Integer {}
interface UnsignedInt: Integer {}

extend bool                                       { impl Scalar: }
extend f16, bf16, f32, f64                        { impl Float: }
extend i8, i16, int, i64, i128, word              { impl SignedInt: }
extend u8, char, u16, u32, rune, u64, u128, uword { impl UnsignedInt: }

