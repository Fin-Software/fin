    (Linux,   X64),
    (Wasi,    Wasm),
    (Wasi,    Wasm64),
    (Windows, Arm64),
    (Windows, X64),
}
enum Arch { X64, Riscv64, Arm64, Wasm64, Wasm }
enum Host { Android, Darwin, Linux, Windows }
enum Mode { Debug, Jit, Safe, Fast, Tiny }


module std/debug

void assert(ok bool) inline  ## unreachable alone doesn't require a function be marked as divergent
    if (!ok) unreachable ;;
;;

