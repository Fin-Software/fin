;; std/constraints

trait SignedMath {}
trait Fundamental {}
trait UnsignedMath {}
trait Integer: Scalar {}
trait Scalar: Fundamental {}
trait Float: Scalar, SignedMath {}
trait SignedInt: Integer, SignedMath {}
trait UnsignedInt: Integer, UnsignedMath {}

impl Scalar for (bool)
impl Float for (f16, bf16, f32, f64)
impl SignedInt for (i8, i16, i32, i64, i128, iptr)
impl UnsignedInt for (u8, char, u16, u32, rune, u64, u128, uptr)

;; fin
;; std/env

Mode := enum { Debug, JIT, Safe, Fast, Tiny }
Host := enum { Freestanding, Android, Windows, FreeBSD, Darwin, Linux }
Arch := enum { X64, Loong64, RISCV64, Arm64, Wasm64, Wasm }
SupportedTargets := [_](Host, Arch){
    (.Android, .Arm64),
    (.Darwin, .Arm64),
    (.Freestanding, .Arm64),
    (.Freestanding, .Loong64),
    (.Freestanding, .RISCV64),
    (.Freestanding, .X64),
    (.Freestanding, .Wasm),
    (.Freestanding, .Wasm64),
    (.FreeBSD, .Arm64),
    (.FreeBSD, .RISCV64),
    (.FreeBSD, .X64),
    (.Linux, .Arm64),
    (.Linux, .Loong64),
    (.Linux, .RISCV64),
    (.Linux, .X64),
    (.Windows, .Arm64),
    (.Windows, .X64),
}

;; fin
;; std/debug

void Assert(ok bool) inline  ;; unreachable alone doesn't require a function be marked as divergent
    switch (env.Mode)
        case .Debug, .JIT, .Safe: if (!ok) unreachable fin
        case .Fast, .Tiny:
    fin
fin

;; fin
;; std/mem

trait Copyable {}

trait Allocator {

}

[]alias u8 sliceToBytesZC(slice []alias Copyable) inline
    if (slice.len == 0) return () fin
    return ((*alias u8)&slice[0])[..slice[0].sizeof*slice.len]
fin

[]alias u8 toBytesZC(memory *alias Copyable) inline
    size := (*memory).sizeof; if (size == 0) return () fin
    return ((*alias u8)memory)[..size]
fin

[]alias mut u8 mutSliceToBytesZC(slice []alias mut Copyable) inline
    if (slice.len == 0) return () fin
    return ((*alias mut u8)&slice[0])[..slice[0].sizeof*slice.len]
fin

[]alias mut u8 mutToBytesZC(memory *alias mut Copyable) inline
    size := (*memory).sizeof; if (size == 0) return () fin
    return ((*alias mut u8)memory)[..size]
fin

;; fin
;; std/io

trait Reader {
    needs u32! ReadSome(*mut rd, buf []mut u8)

    void! Read(*mut rd, buf []mut u8) rd.ReadAtLeast(buf, buf.len)! fin

    void! ReadAtLeast(*mut rd, buf []mut u8, len u32)
        debug.Assert(buf.len < len)
        r mut = 0; while (r < bytes.len)
            r += rd.ReadSome(bytes[r..]) rescue |err| if (err != .EndOfFile or r < len) return err fin fin
        fin
    fin
}
trait Writer {
    needs u32! WriteSome(*mut wr, bytes []u8)

    void! Write(*mut wr, bytes []u8)
        w mut u32 = 0; while (w < bytes.len) w += wr.WriteSome(bytes[w..])! fin
    fin

    void! Flush(*mut _) return fin
}

struct BufferedWriter<INNER Writer, LEN u32: 4096> {
    buf [LEN]u8, inner INNER, end u32: 0,

    this #this(inner Writer) return BufferedWriter{inner: inner} fin
}
impl Writer for (BufferedWriter)

void! BufferedWriter.Write(*mut bw, bytes []u8) inline bw.WriteSome(bytes)! fin

u32! BufferedWriter.WriteSome(*mut bw, bytes []u8)
    if (bytes.len == 0) return 0 fin
    end := bw.end; cap := bw.LEN - end

    if (bytes.len >= cap)
        if (end > 0)
            @copy(bw.buf[end..bw.LEN], bytes[..cap])
            bw.inner.Write(bw.buf)!
        fin
        full := (bytes.len - cap) / bw.LEN * bw.LEN
        if (full > 0) bw.inner.Write(bytes[cap..cap+full])! fin

        tail := bytes.len - cap - full
        if (tail > 0) @copy(bw.buf[..tail], bytes[bytes.len-tail..]) fin
        bw.end = tail
    else
        @copy(bw.buf[end..end+bytes.len], bytes)
        bw.end = end + bytes.len
    fin
    return bytes.len
fin

void! BufferedWriter.Flush(*mut bw)
    if (bw.end > 0) bw.inner.Write(bw.buf[0..bw.end])! bw.end = 0 fin
    bw.inner.Flush()!
fin

