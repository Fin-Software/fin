}
enum Host { freestanding, android, windows, freebsd, darwin, linux }
enum Arch { x64, loong64, riscv64, arm64, wasm64, wasm }
enum Mode { debug, jit, safe, fast, tiny }

;; fin
;; std/debug

void Assert(ok bool) inline  ;; unreachable alone doesn't require a function be marked as divergent
    switch (env.Mode)
        case .debug, .jit, .safe: if (!ok) unreachable fin
        case .fast, .tiny:
    fin
fin

