;; std/mem

trait Copyable {}

trait Allocator {

}

[]alias u8 sliceToBytesZC(slice []alias Copyable) inline
    if (slice.len == 0) return () fin
    return ((*alias u8)&slice[0])[..slice[0].sizeof*slice.len]
fin

[]alias u8 toBytesZC(memory *alias Copyable) inline
    size := (*memory).sizeof; if (size == 0) return () fin
    return ((*alias u8)memory)[..size]
fin

[]alias mut u8 mutSliceToBytesZC(slice []alias mut Copyable) inline
    if (slice.len == 0) return () fin
    return ((*alias mut u8)&slice[0])[..slice[0].sizeof*slice.len]
fin

[]alias mut u8 mutToBytesZC(memory *alias mut Copyable) inline
    size := (*memory).sizeof; if (size == 0) return () fin
    return ((*alias mut u8)memory)[..size]
fin

;; fin
;; std/io

trait Reader {
    needs u32! ReadSome(*mut rd, buf []mut u8)

    void! Read(*mut rd, buf []mut u8) rd.ReadAtLeast(buf, buf.len)! fin

    void! ReadAtLeast(*mut rd, buf []mut u8, len u32)
        debug.Assert(buf.len < len)
        r mut = 0; while (r < bytes.len)
            r += rd.ReadSome(bytes[r..]) rescue |err| if (err != .EndOfFile or r < len) return err fin fin
        fin
    fin
}
trait Writer {
    needs u32! WriteSome(*mut wr, bytes []u8)

    void! Write(*mut wr, bytes []u8)
        w mut = 0; while (w < bytes.len) w += wr.WriteSome(bytes[w..])! fin
    fin

    void! Flush(*mut _) return fin

    void! WriteChar(*mut wr, c char) wr.WriteSome([1]char{c}[..])

    u32! WriteRune(*mut wr, r rune)
        ;; empty
    fin
}

struct BufferedWriter[INNER Writer, LEN u32: 4<<10] {
    buf [LEN]u8, inner INNER, end u32: 0,

    #construct(inner INNER) return BufferedWriter{inner: inner} fin

impl Writer:
    void! Write(*mut bw, bytes []u8) inline bw.WriteSome(bytes)! fin

    u32! WriteSome(*mut bw, bytes []u8)
        if (bytes.len == 0) return 0 fin; end := bw.end; cap := LEN - end

        if (bytes.len >= cap)
            if (end > 0)
                @copy(bw.buf[end..LEN], bytes[..cap])
                bw.inner.Write(bw.buf)!
            fin
            full := (bytes.len - cap) / LEN * LEN
            if (full > 0) bw.inner.Write(bytes[cap..cap+full])! fin

            tail := bytes.len - cap - full
            if (tail > 0) @copy(bw.buf[..tail], bytes[bytes.len-tail..]) fin
            bw.end = tail
        else
            @copy(bw.buf[end..end+bytes.len], bytes)
            bw.end = end + bytes.len
        fin
        return bytes.len
    fin

    void! Flush(*mut bw)
        if (bw.end > 0) bw.inner.Write(bw.buf[0..bw.end])! bw.end = 0 fin
        bw.inner.Flush()!
    fin

    void! Reinit(*mut bw, inner INNER)
        debug.Assert(bw.end == 0); bw.inner = inner
    fin
}

;; fin

u8 Main() return 0 fin

