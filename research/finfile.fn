###################################################################################################
module std/io

interface InStream {

}

interface OutStream {

}

interface Reader: InStream {
    needs int! readSome(rd*; buf char[])

    void! read(rd*; buf char[]) @inline rd.readAtLeast(buf, buf.len)! ;;

    (% @assert buf.len >= len %)
    int! readAtLeast(rd*; buf char[], len int)
        r int; while (r < len)
            n int = rd.readSome(buf[r..])!;
            if (n == 0) return UnexpectedEOF# ;;
            r += n
        ;;
        return r
    ;;
}
interface Writer: OutStream {
    needs int! writeSome(wr*; bytes char[])

    void! write(wr*; bytes char[])
        w int; while (w < bytes.len) w += wr.writeSome(bytes[w..])! ;;
    ;;

    void! writeChar(wr*; c char) @inline wr.writeSome({c}[..])! ;;

    int! writeRune(wr*; r uint)
        if (r < 128) wr.writeChar(r)!; return 1 ;;
        buf char[4]; n int = utf8:encodeRune(buf[..], r)!
        wr.write(buf[..n])!; return n
    ;;

    void! flush(_*) return ;;
}

<><
struct BufferedReader[RDT Reader, LEN int: 4<<10] {
    buf char[LEN], inner RDT, start, end int: 0,

impl Reader:
    void! read(br*; buf char[]) @inline br.readSome(buf)! ;;

    int! readSome(br*; buf char[])
        if (buf.len == 0) return 0 ;; avail int = br.end - br.start
        if (avail > 0)
            n := min(buf.len, avail)
            mem:copy(buf[..n], br.buf[br.start..br.start+n])
            br.start += n
            if (br.start == br.end) br.start = 0; br.end = 0 ;;
            return n
        ;;
        if (buf.len >= LEN)
            return br.inner.readSome(buf)!
        ;;
        br.start = 0
        br.end = br.inner.readSome(br.buf[..])!
        n := min(buf.len, br.end)
        mem:copy(buf[..n], br.buf[..n])
        br.start = n
        if (br.start == br.end) br.start = 0; br.end = 0 ;;
        return n
    ;;

    char[]! peek(br*; want int)
        avail int = br.end - br.start
        if (avail >= want) return br.buf[br.start..br.end] ;;
        if (br.start > 0)
            mem:copy(br.buf[..avail], br.buf[br.start..br.end])
            br.start = 0; br.end = avail
        ;;
        if (want > LEN) BufferTooSmall! ;;
        while (br.end < want)
            n int = br.inner.readSome(br.buf[br.end..])!
            if (n == 0) EndOfFile! ;;
            br.end += n
        ;;
        return br.buf[br.start..br.end]
    ;;

    (% @assert br.start == 0 and br.end == 0 %)
    void! init(br*; inner RDT) br.inner = inner ;;
}
><>

struct BufferedWriter[LEN int: 4<<10] {
    buf char[LEN], inner Writer, end int: 0,

impl Writer:
    void! write(bw*; bytes char[]) @inline bw.writeSome(bytes)! ;;

    int! writeSome(bw*; bytes char[])
        if (bytes.len == 0) return 0 ;; end int = bw.end; cap int = LEN - end

        if (bytes.len >= cap)
            if (end > 0)
                mem:copy(bw.buf[end..LEN], bytes[..cap])
                bw.inner.write(bw.buf)!
            ;;
            full int = (bytes.len - cap) / LEN * LEN
            if (full > 0) bw.inner.write(bytes[cap..cap+full])! ;;

            tail int = bytes.len - cap - full
            if (tail > 0) mem:copy(bw.buf[..tail], bytes[bytes.len-tail..]) ;;
            bw.end = tail
        else
            mem:copy(bw.buf[end..end+bytes.len], bytes)
            bw.end = end + bytes.len
        ;;
        return bytes.len
    ;;

    void! flush(bw*)
        if (bw.end > 0) bw.inner.write(bw.buf[0..bw.end])!; bw.end = 0 ;;
        bw.inner.flush()!
    ;;

    (% BufferedWriter wraps and is generic over inner's underlying type %)
    (% @assert bw.end == 0 %)
    void! init(bw*; inner Writer) bw.inner = inner ;;
}
///////////////////////////////////////////////////////////////////////////////////////////////////

void x()
    while (i int; true)
        defer i *= 2 ;;
        if (i&1)
            defer i += 1 ;;
            i /= 3
        else
            i += 2
        ;;
    ;;
;;

