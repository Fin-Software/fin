###################################################################################################
module std/mem

u8 alias[] sliceToBytesZC[T any](slice T alias[]) inline
    if (slice.len == 0) return {} ;;
    return ((u8 alias*)&slice[0])[..slice[0].sizeof*slice.len]
;;

u8 alias[] toBytesZC[T any](memory T alias*) inline
    size int = (*memory).sizeof; if (size == 0) return {} ;;
    return ((u8 alias*)memory)[..size]
;;

