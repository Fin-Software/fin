###################################################################################################
module std/io

interface Reader {
    needs int! readSome(rd*, buf u8[])

    void! read(rd*, buf u8[]) inline rd.readAtLeast(buf, buf.len)! ;;

    (* assert buf.len >= len *)
    int! readAtLeast(rd*, buf u8[], len int)
        while (r int; r < len; r += n)
            n int = rd.readSome(buf[r..])!; if (n == 0) return UnexpectedEOF! ;;
        ;;
        return r
    ;;
}
interface Writer {
    needs int! writeSome(wr*, bytes u8[])

    void! write(wr*, bytes u8[])
        w int; while (w < bytes.len) w += wr.writeSome(bytes[w..])! ;;
    ;;

    void! writeChar(wr*, c char) inline wr.writeSome({c}[..])! ;;

    int! writeRune(wr*, r rune)
        if (r < 128) wr.writeChar(r)!; return 1 ;;
        buf char[4]; n int = utf8:encodeRune(buf[..], r)!
        wr.write(buf[..n])!; return n
    ;;

    void! flush(_*) return ;;
}

