interface Integer: Scalar {}
interface SignedInt: Integer {}
interface UnsignedInt: Integer {}

extend bool                                    { impl Scalar: }
extend half, bhalf, float, double              { impl Float: }
extend schar, short, int, long, xlong, reg     { impl SignedInt: }
extend char, ushort, uint, ulong, uxlong, ureg { impl UnsignedInt: }

