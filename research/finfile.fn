;; std/constraints

trait SignedMath {}
trait Fundamental {}
trait UnsignedMath {}
trait Integer: Scalar {}
trait Scalar: Fundamental {}
trait Float: Scalar, SignedMath {}
trait SignedInt: Integer, SignedMath {}
trait UnsignedInt: Integer, UnsignedMath {}

impl Scalar for (bool)
impl Float for (f16, bf16, f32, f64)
impl SignedInt for (i8, i16, i32, i64, i128, iptr)
impl UnsignedInt for (u8, char, u16, u32, rune, u64, u128, uptr)

