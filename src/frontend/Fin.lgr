/* Rules <passed> {omitted} subrule */

<eof> -> \z  // Mandatory in LRSTAR.

{whitespace} -> (wchar | ';')+
{skipped} -> (ctrl | nonascii)+

<ctid> -> '_'* upper ('_' | alnum)*
<rtid> -> '_'* lower ('_' | alnum)*

//<string> -> '\"' schar* '\"'

//<rune> -> '\'' rchar '\''

/* Character Classes */

\t = 9
\n = 10
\r = 13
\z = 26

deci = '0'..'9'
upper = 'A'..'Z'
lower = 'a'..'z'
alnum = deci | upper | lower

nonascii = 128..255
neol = any - \n - \r
any = 0..255 - ctrl - \z
wchar = ' ' | \t | \n | \r
ctrl = 127 | 0..31 - wchar - \z

/*
////////////////////////////////////////////////////////////////////////////////////////////////////

bin      = '0'..'1'
octa     = '0'..'7'
hexa     = deci | 'a'..'f' | 'A'..'F'
neol     = any - \n - \r
any      = 0..255 - ignored - \z
\t       = 9
\n       = 10
\r       = 13

ignored  = 0..8 | 11..12 | 14..25 | 27..31 | 127 | 176..177 | 245..255

//escapes -> '\\' '\\'
//        -> '\\' 'n'
//        -> '\\' 't'
//        -> '\\' 'r'
//        -> '\\' hexa hexa


// Ignored bytes
{ignored} -> (0..8 | 11..12 | 14..25 | 27..31 | 127 | 176..177 | 245..255)+

// Whitespace and comments (all discarded)
{whitespace}  -> (' ' | \t | \n | \r | ';')+
{comment}     -> ';' ';' neol*
{mlcomment}   -> '<' '>' '<' any* '>' '<' '>'

// Literals
<integer>  -> deci+ ('\'' deci+)*
            | '0' 'x' hexa+ ('\'' hexa+)*
            | '0' 'b' bin+  ('\'' bin+)*
            | '0' 'o' octa+ ('\'' octa+)*
<float>    -> deci+ '.' deci+ (('e' | 'E') ('+' | '-')? deci+)?
<rune>     -> '\'' (any - '\\' - '\'' | '\\' '\'' | escapes) '\''
<bsstring> -> ((' ' | \t)* '\\' '\\' neol*)+
<dqstring> -> '"' (any - '\\' - '"' | '\\' '"' | escapes)* '"'
<btstring> -> '`' (any - '`')* '`'

// Enum/fault literals (lexer-level, PascalCase after dot)
<enumlit>  -> '.' upper alnum*
<faultlit> -> '.' upper alnum* '!'

// Labels (for named blocks, break targets, etc.)
<label>    -> (upper | '_') (upper | '_' | deci)* ':'

// Identifiers and cased name classes
<typeid>   -> upper (alnum | '_')*                        // PascalCase types
<constid>  -> (upper | '_') (upper | '_' | deci)* '_'?   // THIS_CASE constants/params; must not shadow typeid
<ident>    -> lower (alnum | '_')*                        // camelCase everything else
*/
