VOID             'void';
BOOL             'bool';
                          // literal suffix  1st arith promo
HALF             'half';  // h               f
BHALF           'bhalf';  // bh              f
FLOAT           'float';  // f
DOUBLE         'double';  // d
SCHAR           'schar';  // sc              int
SHORT           'short';  // s               int

INT               'int';  // default literal type; "size" type

LONG             'long';  // l
XLONG           'xlong';  // xl
REG               'reg';  // r
CHAR             'char';  // c               u
USHORT         'ushort';  // us              u
UINT             'uint';  // u
ULONG           'ulong';  // ul
UXLONG         'uxlong';  // uxl
UREG             'ureg';  // ur

// 2nd disambiguating promo:
//   Literals scale up from int.
//   Bitwise never promotes.
//   Signed wins if wider everywhere.
//   Else cast required.

// stdlib: String, String16, String32
// Only u/reg varies by platform.

ALIAS           'alias';
ATINLINE      '@inline';
ATLINKABLE  '@linkable';
ATLINKED      '@linked';
ATNAKED        '@naked';
ATNORETURN  '@noreturn';
ATPRIV          '@priv';
BANG                '!';
CBRACE              '}';
CBRACK              ']';
COLON               ':';
COMMA               ',';
CPAREN              ')';
CTID <ctid> => lookup();
DYN               'dyn';
ELLIPSES          '...';
ENUM             'enum';
EQUALS              '=';
EXTEND         'extend';
FAULT           'fault';
FIN                ';;';
IMPL             'impl';
INTERFACE   'interface';
MODULE         'module';
OBRACE              '{';
OBRACK              '[';
OPAREN              '(';
OPAREN_PCENT       '(%';
PCENT_CPAREN       '%)';
POUND               '#';
RTID <rtid> => lookup();
SLASH               '/';
STAR                '*';
STRUCT         'struct';
QMARK               '?';
UNDERSCORE          '_';

//    Sorted by category and depth-first because I can't help myself.

srcFile: moduleDecl+ <eof>;

///////////////////////////////////////////////////////////////////////////////////////////////////

//expr: ;

///////////////////////////////////////////////////////////////////////////////////////////////////

stmt: ctDecl | rtDecl | structDecl | extendDecl | enumDecl;

///////////////////////////////////////////////////////////////////////////////////////////////////

moduleDecl: MODULE namespace decl+;
namespace: RTID | namespace SLASH RTID;

decl: ctDecl | rtDecl | funcDecl | structDecl | extendDecl | enumDecl | interfaceDecl | faultDecl;

ctDecl: ctids typeSig init;
ctids: CTID | ctids COMMA CTID;

typeSig: typeAtom typePostfix*;
typeAtom: CTID | builtinType | tupleSig;

builtinType
    : VOID  | BOOL   | REG   | UREG
    | HALF  | BHALF  | FLOAT | DOUBLE
    | SCHAR | SHORT  | INT   | LONG   | XLONG
    | CHAR  | USHORT | UINT  | ULONG  | UXLONG;

tupleSig: OPAREN typeTupleElems CPAREN;
typeTupleElems: /* empty */ | typeSigs variadicSig;
typeSigs: typeSig | typeSigs COMMA typeSig;
variadicSig: /* empty */ | COMMA typeSig ELLIPSES COMMA?;

typePostfix: tupleSig STAR | typeSuffix | BANG;

typeSuffix: sliceSuffix | pointerSuffix | arraySuffix | optionalSuffix;
sliceSuffix: OBRACK CBRACK | ALIAS OBRACK CBRACK;
pointerSuffix: STAR | ALIAS STAR;
arraySuffix: OBRACK (expr | UNDERSCORE) CBRACK;
optionalSuffix: QMARK;

init: /* empty */ | COLON expr | EQUALS expr;

rtDecl: rtids typeSig init;
rtids: RTID | rtids COMMA RTID;

funcDecl: contracts typeSig macroOp RTID ctParams OPAREN funcParams? CPAREN attributes body FIN;

contracts: /* empty */ | contracts OPAREN_PCENT PCENT_CPAREN;  // Incomplete.

macroOp: /* empty */ | POUND;

ctParams: /* empty */ | OBRACK params CBRACK;
params: param (COMMA param)* COMMA?;
param: ctids typeSig init;

funcParams: fields | RTID | RTID STAR | RTID fields | RTID STAR fields;
fields: field (COMMA field)* COMMA?;
field: rtids typeSig init;

attributes: /* empty */ | attributes attribute;
attribute: ATPRIV | ATNAKED | ATINLINE | ATLINKED | ATLINKABLE | ATNORETURN;

body: /* empty */ | body stmt;

structDecl: STRUCT CTID ctParams OBRACE fields? funcDecl* implBlock* CBRACE;

implBlock: IMPL ctids COLON funcDecl*;

extendDecl: EXTEND typeSigs OBRACE funcDecl* implBlock* CBRACE;

enumDecl: ENUM CTID OBRACE ctids tuple COMMA? CBRACE;  // Incomplete.
tuple: OPAREN tupleElems CPAREN;
tupleElems: /* empty */ | exprs COMMA?;
exprs: expr | exprs COMMA expr;

interfaceDecl: DYN? INTERFACE CTID (COLON ctids)? OBRACE CBRACE;  // Incomplete.

faultDecl: FAULT ctids FIN;
